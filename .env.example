# Local Go API (Docker Compose supplies this automatically)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/happyrobot?sslmode=disable
REALTIME_DATABASE_URL=postgres://postgres:postgres@localhost:5432/happyrobot?sslmode=disable
PORT=8080
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
AUTO_MIGRATE=true
DB_MAX_CONNS=5

# Local Next.js when not using Docker Compose
NEXT_PUBLIC_API_URL=http://localhost:8080

# Vercel production:
# DATABASE_URL=<Neon pooled Postgres connection string, sslmode=require>
# REALTIME_DATABASE_URL=<Neon direct Postgres connection string, sslmode=require>
# AUTO_MIGRATE=true
# DB_MAX_CONNS=5
# CORS_ORIGIN=https://happyrobot-realtime-tasks.vercel.app
# Do NOT set NEXT_PUBLIC_API_URL on Vercel; same-origin rewrites route /api to Go.
